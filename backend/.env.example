PORT=3000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/grocery-app
JWT_SECRET_KEY=replace_with_a_strong_random_secret
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Recommended for Render Free Tier (which blocks SMTP ports 465/587):
# Set BREVO_API_KEY (free 300 emails/day, no custom domain needed) OR RESEND_API_KEY
BREVO_API_KEY=
RESEND_API_KEY=
# Optional custom sender email (defaults to EMAIL_USER)
EMAIL_FROM=
# Optional: comma-separated allowed frontend URLs for CORS (leave blank to allow all origins)
CLIENT_URL=https://your-frontend-domain.vercel.app
